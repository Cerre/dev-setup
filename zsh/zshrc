# ============================================
# FZF + Ripgrep Integration
# ============================================

# Ctrl+P: Fuzzy search filenames
function _fzf_file_search() {
    local file=$(rg --files --hidden --follow --glob "!.git/*" 2>/dev/null | 
        fzf --preview 'bat --style=numbers --color=always {}' \
            --preview-window 'up,60%,border-bottom')
    
    if [[ -n "$file" ]]; then
        ${EDITOR:-vim} "$file"
    fi
}

# Ctrl+F: Search file contents with ripgrep
function _fzf_rg_search() {
    local result=$(rg --line-number --no-heading --color=always --smart-case '' 2>/dev/null | 
        fzf --ansi \
            --delimiter ':' \
            --preview 'bat --style=numbers --color=always --highlight-line {2} {1}' \
            --preview-window 'up,60%,border-bottom,+{2}+3/3,~3')
    
    if [[ -n "$result" ]]; then
        local file=$(echo "$result" | cut -d':' -f1)
        local line=$(echo "$result" | cut -d':' -f2)
        ${EDITOR:-vim} "$file" +$line
    fi
}

# Ctrl+E: Search tags (functions, classes) - Optional
function _fzf_tag_search() {
    if [[ ! -f "tags" ]]; then
        echo "No tags file found. Run 'ctags -R .' first"
        return
    fi
    
    local result=$(cat tags | grep -v '^!' | fzf \
        --delimiter $'\t' \
        --preview 'bat --style=numbers --color=always {2}' \
        --preview-window 'up,60%,border-bottom')
    
    if [[ -n "$result" ]]; then
        local file=$(echo "$result" | awk -F'\t' '{print $2}')
        ${EDITOR:-vim} "$file"
    fi
}

alias se='setxkbmap se'
alias us='setxkbmap us'
# Bind the functions to keyboard shortcuts
zle -N _fzf_file_search
zle -N _fzf_rg_search
zle -N _fzf_tag_search

bindkey '^p' _fzf_file_search
bindkey '^f' _fzf_rg_search
bindkey '^e' _fzf_tag_search

# Set keyboard layout (only if setxkbmap is available)
