// Place your key bindings in this file to override the defaults
[
    // ============================================
    // Neovim Leader Key Mappings (<space> prefix)
    // ============================================

    // File Navigation (Telescope equivalents)
    {
        "key": "space s f",
        "command": "workbench.action.quickOpen",
        "when": "neovim.mode == normal && editorTextFocus"
    },
    {
        "key": "space s g",
        "command": "workbench.action.findInFiles",
        "when": "neovim.mode == normal && editorTextFocus"
    },
    {
        "key": "space space",
        "command": "workbench.action.showAllEditors",
        "when": "neovim.mode == normal && editorTextFocus"
    },
    {
        "key": "space s h",
        "command": "workbench.action.showCommands",
        "when": "neovim.mode == normal && editorTextFocus"
    },
    {
        "key": "space s w",
        "command": "workbench.action.findInFiles",
        "args": {
            "query": "${selectedText}"
        },
        "when": "neovim.mode == normal && editorTextFocus"
    },
    {
        "key": "space s r",
        "command": "search.action.focusSearchList",
        "when": "neovim.mode == normal && editorTextFocus"
    },
    {
        "key": "space s d",
        "command": "workbench.actions.view.problems",
        "when": "neovim.mode == normal && editorTextFocus"
    },
    {
        "key": "space s .",
        "command": "workbench.action.openRecent",
        "when": "neovim.mode == normal && editorTextFocus"
    },

    // File Explorer (Oil.nvim equivalent)
    // Press - to reveal current file in explorer and focus it
    {
        "key": "-",
        "command": "workbench.files.action.showActiveFileInExplorer",
        "when": "neovim.mode == normal && !filesExplorerFocus"
    },
    // Press - again to go back to editor
    {
        "key": "-",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "neovim.mode == normal && filesExplorerFocus"
    },

    // Current Buffer Search
    {
        "key": "space /",
        "command": "actions.find",
        "when": "neovim.mode == normal && editorTextFocus"
    },

    // ============================================
    // LSP Keybindings (matching Neovim gr* prefix)
    // ============================================
    {
        "key": "g r d",
        "command": "editor.action.revealDefinition",
        "when": "neovim.mode == normal && editorHasDefinitionProvider && editorTextFocus"
    },
    {
        "key": "g r r",
        "command": "editor.action.goToReferences",
        "when": "neovim.mode == normal && editorHasReferenceProvider && editorTextFocus"
    },
    {
        "key": "g r i",
        "command": "editor.action.goToImplementation",
        "when": "neovim.mode == normal && editorHasImplementationProvider && editorTextFocus"
    },
    {
        "key": "g r n",
        "command": "editor.action.rename",
        "when": "neovim.mode == normal && editorHasRenameProvider && editorTextFocus"
    },
    {
        "key": "g r a",
        "command": "editor.action.quickFix",
        "when": "neovim.mode == normal && editorHasCodeActionsProvider && editorTextFocus"
    },
    {
        "key": "g r t",
        "command": "editor.action.goToTypeDefinition",
        "when": "neovim.mode == normal && editorHasTypeDefinitionProvider && editorTextFocus"
    },

    // Hover (K in Neovim)
    {
        "key": "shift+k",
        "command": "editor.action.showHover",
        "when": "neovim.mode == normal && editorTextFocus"
    },

    // ============================================
    // Debugger Shortcuts (VS Code specific)
    // ============================================
    {
        "key": "space d b",
        "command": "editor.debug.action.toggleBreakpoint",
        "when": "neovim.mode == normal && editorTextFocus"
    },
    {
        "key": "space d c",
        "command": "workbench.action.debug.continue",
        "when": "neovim.mode == normal && editorTextFocus"
    },
    {
        "key": "space d s",
        "command": "workbench.action.debug.start",
        "when": "neovim.mode == normal && !inDebugMode && editorTextFocus"
    },
    {
        "key": "space d x",
        "command": "workbench.action.debug.stop",
        "when": "neovim.mode == normal && inDebugMode && editorTextFocus"
    },

    // ============================================
    // Terminal Toggle
    // ============================================
    {
        "key": "ctrl+`",
        "command": "workbench.action.terminal.toggleTerminal",
        "when": "neovim.mode == normal || neovim.mode == insert"
    },

    // ============================================
    // Original Non-Vim Keybindings (preserved)
    // ============================================
    {
        "key": "ctrl+right",
        "command": "cursorLineEnd"
    },
    {
        "key": "ctrl+shift+right",
        "command": "cursorLineEndSelect"
    },
    {
        "key": "alt+right",
        "command": "cursorWordEndRight",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+right",
        "command": "-cursorWordEndRight",
        "when": "textInputFocus"
    },
    {
        "key": "shift+alt+right",
        "command": "cursorWordEndRightSelect",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+shift+right",
        "command": "-cursorWordEndRightSelect",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+left",
        "command": "cursorLineStart"
    },
    {
        "key": "ctrl+shift+left",
        "command": "cursorLineStartSelect"
    },
    {
        "key": "alt+left",
        "command": "cursorWordStartLeft"
    },
    {
        "key": "shift+alt+left",
        "command": "cursorWordStartLeftSelect"
    }
]