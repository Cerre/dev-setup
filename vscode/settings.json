{
    "explorer.confirmDelete": false,
    "zig.zls.enabled": "on",

    // ============================================
    // Neovim Integration
    // ============================================
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },

    // Path to Neovim binary (adjust if needed)
    "vscode-neovim.neovimExecutablePaths.linux": "/usr/bin/nvim",
    "vscode-neovim.neovimExecutablePaths.darwin": "/opt/homebrew/bin/nvim",

    // Use your actual Neovim config
    "vscode-neovim.neovimInitVimPaths.linux": "~/.config/nvim/init.lua",
    "vscode-neovim.neovimInitVimPaths.darwin": "~/.config/nvim/init.lua",

    // Let Neovim handle these keys
    "vscode-neovim.useCtrlKeys": true,
    "vscode-neovim.ctrlKeysForNormalMode": ["a", "d", "f", "h", "j", "k", "l", "o", "r", "t", "u", "w"],
    "vscode-neovim.ctrlKeysForInsertMode": ["a", "h", "j", "o", "t", "u", "w"],

    // Cursor configuration
    "vscode-neovim.compositeKeys": {
        "jk": {
            "command": "vscode-neovim.escape"
        }
    },

    // ============================================
    // Editor Settings (Vim-friendly)
    // ============================================
    "editor.lineNumbers": "relative",
    "editor.cursorSurroundingLines": 8,
    "editor.scrollBeyondLastLine": false,

    // Use system clipboard
    "editor.clipboard": "system",

    // Disable features that conflict with Vim
    "editor.snippetSuggestions": "top",
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.acceptSuggestionOnEnter": "smart",
    "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": false
    },

    // ============================================
    // Git Integration
    // ============================================
    "git.enableSmartCommit": true,
    "git.confirmSync": false,

    // ============================================
    // Terminal
    // ============================================
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "line"
}